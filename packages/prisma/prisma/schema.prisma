datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String @id @default(uuid()) @db.Uuid
  email     String   @unique
  password String?    
  name      String?
  role      Role     @default(USER)
  refreshToken String? @default("") 
  createdAt DateTime @default(now())
  session   NoteSession[]
@@index([id], name: "note_user_id_idx")
}

model NoteSession{
id        String @id @default(uuid()) @db.Uuid
createdAt DateTime @default(now())
topic    String?    @db.VarChar(255)
note Note[]
userId  String?   @db.Uuid
user    User?    @relation(fields: [userId], references: [id])
deleated  Boolean  @default(false)
@@index([id], name: "note_session_id_idx")
@@index([topic], name: "note_session_topic_idx")
}

model Note {
  id        String @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(255)
  isBookmarked Boolean @default(false)
  summary   String   
  sessionId  String?    @db.Uuid
  note    NoteSession?    @relation(fields: [sessionId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  deleated  Boolean  @default(false)
@@index([title], name: "note_title_id_idx")
@@index([id], name: "note_id_idx")

}

enum Role {
  USER
  ADMIN
}